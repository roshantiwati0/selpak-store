# Is file ko copy karke ".env.local" naam do, phir values bharo.
# ".env.local" kabhi git me commit nahi hoti.

# Website ka asli address (SEO, sitemap ke liye)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend ka base URL. KHAALI chhodne par app DEMO mode me chalta hai
# (orders/login browser ke localStorage me, koi asli payment nahi).
NEXT_PUBLIC_API_URL=

# Razorpay ka PUBLIC key id (rzp_test_... ya rzp_live_...).
# Secret key yahan kabhi mat daalo; woh sirf backend ke paas rehti hai.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
